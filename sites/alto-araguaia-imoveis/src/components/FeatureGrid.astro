---
import type { Feature } from "../data/site.types";

interface Props {
  items: Feature[];
}

const { items } = Astro.props;
---

<div class="benefit-grid">
  {
    items.map((item) => (
      <article class="benefit-card">
        <span class="benefit-number" aria-hidden="true">{item.icon}</span>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>
    ))
  }
</div>
