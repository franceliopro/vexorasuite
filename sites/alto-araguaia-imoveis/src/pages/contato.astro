---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site.config";
import { whatsappHref } from "../lib/config";

const channels = site.channels.map((channel) => ({
  ...channel,
  href: whatsappHref(channel.whatsapp, `Olá! Gostaria de falar sobre ${channel.label.toLowerCase()}.`),
}));
---

<BaseLayout title={`Contato | ${site.name}`} description={`Fale com ${site.name} em Alto Araguaia e região.`}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={[{ label: "Início", href: "/" }, { label: "Contato", href: "/contato/" }]} />
      <span class="eyebrow">Contato</span>
      <h1>Vamos conversar?</h1>
      <p>Conte o que você precisa. Retornamos pelo canal informado.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid cols-2 contact-layout">
      <ContactForm heading="Envie sua mensagem" />

      <aside aria-label="Canais de atendimento">
        <h2>Canais de atendimento</h2>
        <div class="channel-grid">
          {
            channels.map(
              (channel) =>
                channel.href && (
                  <div class="channel-card">
                    <h3>{channel.label}</h3>
                    <p>{channel.description}</p>
                    <div class="info-row">
                      <span class="info-label">Telefone</span>
                      <strong>{channel.phone}</strong>
                    </div>
                    <div class="info-row">
                      <span class="info-label">WhatsApp</span>
                      <strong>
                        <a href={channel.href} target="_blank" rel="noopener noreferrer">Iniciar conversa</a>
                      </strong>
                    </div>
                  </div>
                ),
            )
          }
        </div>

        <div class="info-row">
          <span class="info-label">Endereço</span>
          <strong>{site.address}</strong>
        </div>
        <div class="info-row">
          <span class="info-label">Atendimento</span>
          <strong>{site.hours}</strong>
        </div>
        <div class="info-row">
          <span class="info-label">CRECI</span>
          <strong>{site.creci}</strong>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
