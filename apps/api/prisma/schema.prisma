// Véxora Suite - Prisma schema (sites deploy via Cloudflare)
// Mantido em sincronia com packages/database/prisma/schema.prisma
// O build (Dokploy) roda `prisma generate` dentro de apps/api, por isso este arquivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  DRAFT
  DEPLOYING
  LIVE
  FAILED
}

enum DeployStatus {
  QUEUED
  UPLOADING
  DEPLOYED
  FAILED
}

enum DomainStatus {
  PENDING_DNS
  VERIFYING
  ACTIVE
  FAILED
}

model Site {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String   @unique
  status      SiteStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domains     SiteDomain[]
  deployments SiteDeployment[]

  @@index([tenantId])
}

model SiteDomain {
  id             String       @id @default(cuid())
  siteId         String
  domain         String       @unique
  status         DomainStatus @default(PENDING_DNS)
  cfProjectName  String?
  cfZoneId       String?
  dnsRecordId    String?
  sslStatus      String?
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deployments    SiteDeployment[]

  @@index([siteId])
}

model SiteDeployment {
  id             String       @id @default(cuid())
  siteId         String
  domainId       String?
  status         DeployStatus  @default(QUEUED)
  cfDeploymentId String?
  cfDeploymentUrl String?
  contentHash    String?
  errorMessage   String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  domain         SiteDomain?  @relation(fields: [domainId], references: [id])

  @@index([siteId])
  @@index([contentHash])
}