model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Only the SHA-256 hash is stored, so a database leak cannot be replayed.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Session is bound to one company; the access token is reissued for it.
  tenantId       String    @map("tenant_id") @db.Uuid
  /// SHA-256 of the secret. The raw value only exists in the client cookie.
  tokenHash      String    @unique @map("token_hash")
  /// Rotation family: presenting a used token revokes every token in the same family.
  familyId       String    @map("family_id") @db.Uuid
  /// authVersion at issue time. A password change or logout bumps it and kills the row.
  sessionVersion Int       @map("session_version")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  revokedAt      DateTime? @map("revoked_at")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

