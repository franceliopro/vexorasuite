{
  "name": "vexorasuite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "shell:check": "pnpm --filter @vexorasuite/shell test",
    "shell:icon": "pnpm --filter @vexorasuite/shell icon",
    "shell:dev": "pnpm --filter @vexorasuite/shell dev:desktop",
    "shell:build:desktop": "pnpm --filter @vexorasuite/shell build:desktop",
    "shell:build:android": "pnpm --filter @vexorasuite/shell build:android",
    "shell:build:ios": "pnpm --filter @vexorasuite/shell build:ios",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "7.0.2"
  }
}
