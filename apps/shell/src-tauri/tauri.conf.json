{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Véxora Suite",
  "version": "0.1.0",
  "identifier": "br.com.vexorasuite.shell",
  "build": {
    "frontendDist": "https://app.vexorasuite.com.br",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @vexorasuite/web dev",
    "beforeBuildCommand": "pnpm --filter @vexorasuite/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Véxora Suite",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-local"]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "copyright": "Véxora Suite",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
