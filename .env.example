# Public URL for the web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# Compose / worker deployment values
POSTGRES_USER=vexora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vexorasuite
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
SCHEDULER_MODE=worker
SCHEDULER_ROLE=worker
WEBHOOK_WORKER_INTERVAL_MS=2000
WEBHOOK_WORKER_BATCH_SIZE=25
# Required in production: stable key for encrypting webhook payloads at rest.
WEBHOOK_ENCRYPTION_KEY=CHANGE_ME
# Use a stable random secret in production; do not rotate without re-encrypting webhook data.

# PostgreSQL (never commit real credentials)
DATABASE_URL=postgresql://vexora:change-me@localhost:5432/vexorasuite

# Authentication: generate with "openssl rand -base64 48".
# Configure the real value as JWT_ACCESS_SECRET in Dokploy; never commit it.
JWT_ACCESS_SECRET=CHANGE_ME
PUBLIC_APP_URL=http://localhost:3000
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# Optional WhatsApp gateway (keep it on a private network; never expose its API key).
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
# WAHA sem navegador: GOWS é leve e adequado para múltiplas instâncias.
WAHA_IMAGE=devlikeapro/waha:gows
WHATSAPP_DEFAULT_ENGINE=GOWS
# Mídia local expira em 10 minutos; use S3/MinIO quando precisar persistir arquivos.
WHATSAPP_FILES_LIFETIME=600
WAHA_MEDIA_STORAGE=LOCAL
# Baixa apenas a mídia de mensagens novas para que a Véxora possa exibi-la.
# Isto não sincroniza o histórico antigo do WhatsApp.
WAHA_EVENTS_DOWNLOAD_MEDIA=true
WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC=false
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT=0
WAHA_GOWS_DEVICE_HISTORY_SYNC_RECENT_SYNC_DAYS_LIMIT=0
WAHA_GOWS_DEVICE_HISTORY_SYNC_INITIAL_SYNC_MAX_MESSAGES_PER_CHAT=0
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_SIZE_MB_LIMIT=1
WAHA_GOWS_DEVICE_HISTORY_SYNC_STORAGE_QUOTA_MB=1

# Meta Official integrations (configure real values only in Dokploy).
# Leave blank until the Meta app, OAuth redirect URI and webhook are configured.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=

# Redis / background jobs
REDIS_URL=redis://localhost:6379

# Set these only in the deployment secret store.
# WAHA_BASE_URL=
# WAHA_API_KEY=

# Zernio social publishing/inbox API key (configure only in Dokploy secrets; never commit a real key).
ZERNIO_API_KEY=
# Shared signed webhook endpoint for all company profiles; configure this same secret in Zernio.
ZERNIO_WEBHOOK_SECRET=

# Optional Intelligence Engine providers. Rules, reports and deterministic Skills do not need these.
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
LOCAL_VOICE_URL=
LOCAL_STT_MODEL=
LOCAL_TTS_MODEL=
LOCAL_TTS_VOICE=pf_dora
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Chave estável de 32 bytes em hexadecimal para criptografar credenciais de integrações, inclusive caixas IMAP/SMTP.
# Obrigatória no Dokploy para cadastrar uma caixa; não rotacione sem recriptografar os dados existentes.
INTEGRATION_ENCRYPTION_KEY=

# Google integrations (configure real values only in Dokploy).
WEB_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=

# Optional per-company SMS/voice gateway routes. Store real JSON and credentials only in Dokploy.

# Rate limiting (see docs/rate-limiting.md). Limits are per minute, per user or per client IP.
# With REDIS_URL set the counter is shared by every replica; without it each process keeps its own.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_AUX_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=900
RATE_LIMIT_WRITE_PER_MIN=240
RATE_LIMIT_UPLOAD_PER_MIN=60
# Number of reverse proxies in front of the API (Dokploy/Traefik = 1). Use 0 to disable.
TRUST_PROXY=1

# Realtime polling/retention controls.
REALTIME_POLL_MS=5000
REALTIME_EVENT_RETENTION_DAYS=7

# Outgoing e-mail (see docs/email.md). Leave MAIL_HOST empty to keep sending disabled:
# messages are then only written to the log and reported as NOT delivered.
# MAIL_TRANSPORT: smtp (default when MAIL_HOST is set) | log | off
MAIL_TRANSPORT=
# Provider preset: gmail | zoho | titan | outlook. Fills host, port and TLS for you.
MAIL_SERVICE=
MAIL_HOST=
MAIL_PORT=587
# true for implicit TLS (port 465). Leave blank to derive it from MAIL_PORT.
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Vexora Suite
MAIL_REPLY_TO=

# Sessions (see docs/sessions.md).
# Access token lifetime in seconds: short, because the refresh token renews it transparently.
AUTH_ACCESS_TTL_SECONDS=1800
# Refresh token lifetime in days (1-180). Rotated on every use; reuse revokes the whole family.
AUTH_REFRESH_TTL_DAYS=30

# Internal QA / screenshot output directory (only used by local validation scripts).
VEXORA_QA_OUTPUT=work/qa
