{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Véxora Suite",
  "version": "0.1.0",
  "identifier": "br.com.vexorasuite.app",
  "build": {
    "frontendDist": "https://app.vexorasuite.com.br",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "pnpm --filter @vexorasuite/web dev",
    "beforeBuildCommand": "pnpm --filter @vexorasuite/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Véxora Suite",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https:;img-src 'self' data: https:;font-src 'self' https:;style-src 'self' 'unsafe-inline' https:;connect-src 'self' https: wss: ws:;frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "copyright": "Véxora Suite",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "vexorasuite.com.br"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
