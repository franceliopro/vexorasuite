{
  "name": "@vexorasuite/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --experimental-vm-modules -r ./scripts/typescript6-require-hook.cjs ./node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "mail:check": "node dist/mail/mail-check.cli.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "htmlparser2": "12.0.0",
    "imapflow": "^1.0.181",
    "ioredis": "^6.0.0",
    "mailparser": "^3.9.0",
    "nodemailer": "^10.3.1",
    "officeparser": "^8.4.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^30.1.3",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/adm-zip": "^0.6.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/sanitize-html": "2.16.2",
    "dotenv": "18.0.10",
    "eslint": "^9.36.0",
    "globals": "^15.15.0",
    "jest": "^30.1.3",
    "prisma": "7.10.1",
    "ts-jest": "^29.4.4",
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.46.0"
  }
}
