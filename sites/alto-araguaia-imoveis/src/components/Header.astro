---
import { site } from "../data/site.config";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Alto Araguaia Imóveis — início">
      <img src="/logo.svg" alt="Alto Araguaia Imóveis" width="180" height="34" />
    </a>

    <nav class="nav-links" data-nav aria-label="Navegação principal">
      {
        site.navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="/anuncie-seu-imovel/">Anuncie seu imóvel</a>
    </nav>

    <div class="nav-actions">
      <a class="btn btn-navy" href="/anuncie-seu-imovel/">Anuncie seu imóvel</a>
      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="Abrir menu"
        aria-controls="primary-nav"
        aria-expanded="false"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  nav?.setAttribute("id", "primary-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
  });
  nav?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
