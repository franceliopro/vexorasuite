# URL canônica pública do site (sem barra final).
PUBLIC_SITE_URL=https://altoaraguaia-imoveis.example

# Opcional: endpoint HTTPS que recebe POST do formulário de contato.
# Sem ele, o formulário abre WhatsApp ou e-mail e nunca afirma envio confirmado.
PUBLIC_CONTACT_ENDPOINT=

# Opcional: URL pública do Worker de anúncios (POST /api/forms/anunciar).
# Usada somente em /anuncie-seu-imovel/. Sem ela, a página abre o WhatsApp.
# Isto é configuração de build, não prova de que o Worker está implantado.
PUBLIC_ANNOUNCEMENTS_ENDPOINT=
