# Public URL for the web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (never commit real credentials)
DATABASE_URL=postgresql://vexora:change-me@localhost:5432/vexorasuite

# Authentication: generate with "openssl rand -base64 48".
# Configure the real value as JWT_ACCESS_SECRET in Dokploy; never commit it.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
PUBLIC_APP_URL=http://localhost:3000

# Optional WhatsApp gateway (keep it on a private network; never expose its API key).
WAHA_BASE_URL=
WAHA_API_KEY=

# Redis / background jobs
REDIS_URL=redis://localhost:6379

# Set these only in the deployment secret store.
# WAHA_BASE_URL=
# WAHA_API_KEY=
