# URL canônica pública do site (sem barra final).
PUBLIC_SITE_URL=https://catalogo.example.com

# Opcional: endpoint HTTPS que recebe POST do formulário de contato.
# Sem ele, o formulário abre WhatsApp ou e-mail e nunca afirma envio confirmado.
PUBLIC_CONTACT_ENDPOINT=

# Origem da API Véxora consultada no build. Use HTTPS; http é aceito apenas em localhost.
# Sem este valor e o token, o snapshot vira NOT_CONFIGURED e a vitrine fica vazia.
VEXORA_API_ORIGIN=

# Token público da vitrine, usado somente no ambiente de build.
# Nunca coloque este valor em src/, commits ou bundle.
VEXORA_CATALOG_TOKEN=

# Caminho opcional do snapshot gerado (padrão: src/data/catalog.json).
# A verificação espera o arquivo nesse caminho padrão.
VEXORA_CATALOG_OUTPUT=

# Timeout da consulta ao feed, em milissegundos (padrão: 15000).
VEXORA_CATALOG_TIMEOUT_MS=15000
