generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationHandlingMode {
  BOT
  HUMAN
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  contacts    Contact[]
  conversations Conversation[]
  messages    Message[]
  channelConnections ChannelConnection[]
  auditLogs   AuditLog[]
  departments Department[]
  payments Payment[]
  serviceProtocols ServiceProtocol[]
  googleConnections GoogleConnection[]
  googleOAuthAttempts GoogleOAuthAttempt[]
  workTasks WorkTask[]
  integrations Json @default("{}")

  @@map("tenants")
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  passwordHash    String            @map("password_hash")
  name            String
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  memberships     Membership[]
  auditLogs       AuditLog[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  departmentMemberships DepartmentMember[]
  conversationParticipations ConversationParticipant[]
  assignedWorkTasks WorkTask[] @relation("WorkTaskAssignee")
  createdWorkTasks WorkTask[] @relation("WorkTaskCreator")

  @@map("users")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid @map("tenant_id")
  userId    String         @db.Uuid @map("user_id")
  role      MembershipRole @default(AGENT)
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Contact {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid @map("tenant_id")
  name         String
  phone        String?
  email        String?
  source       String?
  externalId   String?        @map("external_id")
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  payments Payment[]

  @@unique([tenantId, externalId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid @map("tenant_id")
  contactId   String             @db.Uuid @map("contact_id")
  channelConnectionId String?    @db.Uuid @map("channel_connection_id")
  assigneeId  String?            @db.Uuid @map("assignee_id")
  departmentId String?           @db.Uuid @map("department_id")
  handlingMode ConversationHandlingMode @default(BOT) @map("handling_mode")
  archivedAt DateTime? @map("archived_at")
  deletedAt DateTime? @map("deleted_at")
  botState Json @default("{}") @map("bot_state")
  channel     String             @default("WHATSAPP")
  status      ConversationStatus @default(OPEN)
  subject     String?
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  assignee    User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages    Message[]
  participants ConversationParticipant[]
  payments Payment[]
  serviceProtocol ServiceProtocol?

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, contactId])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, channelConnectionId, status])
  @@index([tenantId, archivedAt, deletedAt])
  @@map("conversations")
}

model ChannelConnection {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  provider    String   @default("WAHA")
  name        String
  sessionName String   @unique @map("session_name")
  status      String   @default("CONNECTING")
  lastError   String?  @map("last_error")
  isActive    Boolean  @default(true) @map("is_active")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId, status])
  @@map("channel_connections")
}

model Department {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid @map("tenant_id")
  key            String
  name           String
  keywords       String[]       @default([])
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  members DepartmentMember[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("departments")
}

model DepartmentMember {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid @map("tenant_id")
  departmentId String     @db.Uuid @map("department_id")
  userId       String     @db.Uuid @map("user_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([tenantId, userId])
  @@map("department_members")
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid @map("tenant_id")
  conversationId String       @db.Uuid @map("conversation_id")
  userId         String       @db.Uuid @map("user_id")
  kind           String       @default("INVITED")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
  @@map("conversation_participants")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid @map("tenant_id")
  conversationId     String   @db.Uuid @map("conversation_id")
  contactId          String   @db.Uuid @map("contact_id")
  provider           String   @default("ASAAS")
  externalId         String?  @map("external_id")
  amount             Decimal  @db.Decimal(12, 2)
  status             String   @default("PENDING")
  billingType        String?  @map("billing_type")
  invoiceUrl         String?  @map("invoice_url")
  bankSlipUrl        String?  @map("bank_slip_url")
  pixPayload         String?  @map("pix_payload")
  environment        String   @default("SANDBOX")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  contact             Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
  @@map("payments")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid @map("tenant_id")
  conversationId    String           @db.Uuid @map("conversation_id")
  providerMessageId String?          @map("provider_message_id")
  direction         MessageDirection
  status            MessageStatus    @default(RECEIVED)
  content           String           @default("")
  contentType       String           @default("text") @map("content_type")
  senderName        String?           @map("sender_name")
  metadata          Json              @default("{}")
  occurredAt        DateTime          @default(now()) @map("occurred_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, conversationId, occurredAt])
  @@map("messages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  userId     String?  @db.Uuid @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

/** Stable automation reference for a conversation, scoped to a tenant. */
model ServiceProtocol {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  conversationId String @unique @db.Uuid @map("conversation_id")
  code String
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@map("service_protocols")
}

model GoogleOAuthAttempt {
  stateHash String @id @map("state_hash")
  tenantId String @db.Uuid @map("tenant_id")
  userId String @db.Uuid @map("user_id")
  verifierEncrypted String @map("verifier_encrypted")
  service String
  expiresAt DateTime @map("expires_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("google_oauth_attempts")
}

model GoogleConnection {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  googleAccountId String @map("google_account_id")
  email String
  scopes String
  refreshTokenEncrypted String? @map("refresh_token_encrypted")
  accessTokenEncrypted String @map("access_token_encrypted")
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, googleAccountId])
  @@map("google_connections")
}

model WorkTask {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  title String
  description String @default("")
  status String @default("OPEN")
  priority String @default("NORMAL")
  complexity Int @default(1)
  assigneeId String? @db.Uuid @map("assignee_id")
  createdById String @db.Uuid @map("created_by_id")
  contactId String? @db.Uuid @map("contact_id")
  conversationId String? @db.Uuid @map("conversation_id")
  dueAt DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  assignee User? @relation("WorkTaskAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  creator User @relation("WorkTaskCreator",fields:[createdById],references:[id])
  steps WorkTaskStep[]
  @@index([tenantId,status,dueAt])
  @@index([tenantId,assigneeId])
  @@map("work_tasks")
}
model WorkTaskStep {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid @map("task_id")
  label String
  done Boolean @default(false)
  position Int @default(0)
  checkedAt DateTime? @map("checked_at")
  checkedById String? @db.Uuid @map("checked_by_id")
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Cascade)
  @@index([taskId,position])
  @@map("work_task_steps")
}
