generator client {
  provider = "prisma-client-js"
}

model PushConfiguration {
  tenantId String @id @db.Uuid @map("tenant_id")
  publicKey String @map("public_key")
  privateKeyEncrypted String @map("private_key_encrypted")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  @@map("push_configurations")
}
model PushSubscription {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  userId String @db.Uuid @map("user_id")
  endpointHash String @unique @map("endpoint_hash")
  endpoint String
  p256dh String
  auth String
  createdAt DateTime @default(now()) @map("created_at")
  lastTestAt DateTime? @map("last_test_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([tenantId,userId])
  @@map("push_subscriptions")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationHandlingMode {
  BOT
  HUMAN
}

model Tenant {
  pipelines CrmPipeline[]
  mailAccounts MailAccount[]
  mailTemplates MailTemplate[]
  internalWorkflows InternalWorkflow[]
  pushConfiguration PushConfiguration?
  pushSubscriptions PushSubscription[]
  marketingJobs MarketingJob[]
  marketingWorkflows MarketingWorkflow[]
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  kind        String       @default("COMPANY")
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  authorizedContacts AuthorizedContact[]
  contacts    Contact[]
  conversations Conversation[]
  messages    Message[]
  channelConnections ChannelConnection[]
  auditLogs   AuditLog[]
  departments Department[]
  payments Payment[]
  serviceProtocols ServiceProtocol[]
  googleConnections GoogleConnection[]
  googleOAuthAttempts GoogleOAuthAttempt[]
  workTasks WorkTask[]
  calendarAssignments CalendarAssignment[]
  creativeReferences CreativeReference[]
  integrations Json @default("{}")

  @@map("tenants")
}

model MarketingJob {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  userId String @db.Uuid @map("user_id")
  requestKey String @map("request_key")
  status String @default("QUEUED")
  payload Json
  result Json?
  error String?
  runAt DateTime @default(now()) @map("run_at")
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  @@unique([tenantId,requestKey])
  @@index([status,runAt])
  @@index([tenantId,createdAt])
  @@map("marketing_jobs")
}

model MarketingWorkflow {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  userId String @db.Uuid @map("user_id")
  name String
  enabled Boolean @default(true)
  payload Json
  everyDays Int @default(0) @map("every_days")
  nextRunAt DateTime @map("next_run_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  @@index([enabled,nextRunAt])
  @@index([tenantId,createdAt])
  @@map("marketing_workflows")
}

model User {
  pushSubscriptions PushSubscription[]
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  avatarUrl       String? @map("avatar_url")
  avatarSource    String? @map("avatar_source")
  avatarCheckedAt DateTime? @map("avatar_checked_at")
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  authVersion Int @default(0) @map("auth_version")
  passwordHash    String            @map("password_hash")
  name            String
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  memberships     Membership[]
  auditLogs       AuditLog[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  departmentMemberships DepartmentMember[]
  conversationParticipations ConversationParticipant[]
  assignedWorkTasks WorkTask[] @relation("WorkTaskAssignee")
  createdWorkTasks WorkTask[] @relation("WorkTaskCreator")

  @@map("users")
}

model Membership {
  deniedModules String[] @default([]) @map("denied_modules")
  modules String[] @default([])
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid @map("tenant_id")
  userId    String         @db.Uuid @map("user_id")
  role      MembershipRole @default(AGENT)
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Contact {
  pipelineId String? @db.Uuid @map("pipeline_id")
  pipeline CrmPipeline? @relation(fields:[pipelineId],references:[id],onDelete:Restrict)
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid @map("tenant_id")
  name         String
  phone        String?
  email        String?
  source       String?
  externalId   String?        @map("external_id")
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  authorizedPeople AuthorizedContact[]
  payments Payment[]

  @@unique([tenantId, externalId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid @map("tenant_id")
  contactId   String             @db.Uuid @map("contact_id")
  channelConnectionId String?    @db.Uuid @map("channel_connection_id")
  assigneeId  String?            @db.Uuid @map("assignee_id")
  departmentId String?           @db.Uuid @map("department_id")
  handlingMode ConversationHandlingMode @default(BOT) @map("handling_mode")
  archivedAt DateTime? @map("archived_at")
  deletedAt DateTime? @map("deleted_at")
  botState Json @default("{}") @map("bot_state")
  channel     String             @default("WHATSAPP")
  status      ConversationStatus @default(OPEN)
  subject     String?
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  assignee    User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages    Message[]
  participants ConversationParticipant[]
  payments Payment[]
  serviceProtocol ServiceProtocol?

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, contactId])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, channelConnectionId, status])
  @@index([tenantId, archivedAt, deletedAt])
  @@map("conversations")
}

model ChannelConnection {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  provider    String   @default("WAHA")
  name        String
  sessionName String   @unique @map("session_name")
  status      String   @default("CONNECTING")
  lastError   String?  @map("last_error")
  isActive    Boolean  @default(true) @map("is_active")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId, status])
  @@map("channel_connections")
}

model Department {
  modules String[] @default([])
  routingCategory String? @map("routing_category")
  routingPlatform String? @map("routing_platform")
  pipeline CrmPipeline?
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid @map("tenant_id")
  key            String
  name           String
  keywords       String[]       @default([])
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  members DepartmentMember[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("departments")
}

model DepartmentMember {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid @map("tenant_id")
  departmentId String     @db.Uuid @map("department_id")
  userId       String     @db.Uuid @map("user_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([tenantId, userId])
  @@map("department_members")
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid @map("tenant_id")
  conversationId String       @db.Uuid @map("conversation_id")
  userId         String       @db.Uuid @map("user_id")
  kind           String       @default("INVITED")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
  @@map("conversation_participants")
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid @map("tenant_id")
  conversationId     String   @db.Uuid @map("conversation_id")
  contactId          String   @db.Uuid @map("contact_id")
  provider           String   @default("ASAAS")
  externalId         String?  @map("external_id")
  amount             Decimal  @db.Decimal(12, 2)
  status             String   @default("PENDING")
  billingType        String?  @map("billing_type")
  invoiceUrl         String?  @map("invoice_url")
  bankSlipUrl        String?  @map("bank_slip_url")
  pixPayload         String?  @map("pix_payload")
  environment        String   @default("SANDBOX")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  contact             Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
  @@map("payments")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid @map("tenant_id")
  conversationId    String           @db.Uuid @map("conversation_id")
  providerMessageId String?          @map("provider_message_id")
  direction         MessageDirection
  status            MessageStatus    @default(RECEIVED)
  content           String           @default("")
  contentType       String           @default("text") @map("content_type")
  senderName        String?           @map("sender_name")
  metadata          Json              @default("{}")
  occurredAt        DateTime          @default(now()) @map("occurred_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, conversationId, occurredAt])
  @@map("messages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  userId     String?  @db.Uuid @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

/** Stable automation reference for a conversation, scoped to a tenant. */
model ServiceProtocol {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  conversationId String @unique @db.Uuid @map("conversation_id")
  code String
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
  @@map("service_protocols")
}

model GoogleOAuthAttempt {
  stateHash String @id @map("state_hash")
  tenantId String @db.Uuid @map("tenant_id")
  userId String @db.Uuid @map("user_id")
  verifierEncrypted String @map("verifier_encrypted")
  service String
  expiresAt DateTime @map("expires_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("google_oauth_attempts")
}

model GoogleConnection {
  creativeReferences CreativeReference[]
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  googleAccountId String @map("google_account_id")
  email String
  scopes String
  disabledServices String[] @default([]) @map("disabled_services")
  refreshTokenEncrypted String? @map("refresh_token_encrypted")
  accessTokenEncrypted String @map("access_token_encrypted")
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, googleAccountId])
  @@map("google_connections")
}

model WorkTask {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  title String
  description String @default("")
  status String @default("OPEN")
  priority String @default("NORMAL")
  complexity Int @default(1)
  assigneeId String? @db.Uuid @map("assignee_id")
  createdById String @db.Uuid @map("created_by_id")
  contactId String? @db.Uuid @map("contact_id")
  conversationId String? @db.Uuid @map("conversation_id")
  dueAt DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  assignee User? @relation("WorkTaskAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  creator User @relation("WorkTaskCreator",fields:[createdById],references:[id])
  steps WorkTaskStep[]
  @@index([tenantId,status,dueAt])
  @@index([tenantId,assigneeId])
  @@map("work_tasks")
}
model WorkTaskStep {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid @map("task_id")
  label String
  done Boolean @default(false)
  position Int @default(0)
  checkedAt DateTime? @map("checked_at")
  checkedById String? @db.Uuid @map("checked_by_id")
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Cascade)
  @@index([taskId,position])
  @@map("work_task_steps")
}

model CalendarAssignment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  accountId String @db.Uuid @map("account_id")
  calendarId String @map("calendar_id")
  userId String? @db.Uuid @map("user_id")
  departmentId String? @db.Uuid @map("department_id")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  @@unique([tenantId,accountId,calendarId,userId,departmentId])
  @@index([tenantId,userId])
  @@index([tenantId,departmentId])
  @@map("calendar_assignments")
}

model AuthorizedContact {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  contactId String @db.Uuid @map("contact_id")
  name String
  phone String
  relationship String
  permissions Json @default("[]")
  status String @default("PENDING")
  verifiedById String? @db.Uuid @map("verified_by_id")
  verifiedAt DateTime? @map("verified_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, status])
  @@index([tenantId, phone])
  @@map("authorized_contacts")
}


model CreativeReference {
  deletedAt DateTime? @map("deleted_at")
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  accountId String? @db.Uuid @map("account_id")
  fileId String @map("file_id")
  name String
  mimeType String @map("mime_type")
  purpose String @default("ALL")
  instructions String @default("")
  palette Json @default("[]")
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
  account GoogleConnection? @relation(fields:[accountId],references:[id],onDelete:SetNull)
  @@unique([tenantId,accountId,fileId])
  @@index([tenantId,enabled,purpose])
  @@map("creative_references")
}

model PublicationFolder {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 userId String @db.Uuid @map("user_id")
 accountId String @db.Uuid @map("account_id")
 folderId String @map("folder_id")
 publishedFolderId String @map("published_folder_id")
 mode String
 channelIds String[] @db.Uuid @map("channel_ids")
 enabled Boolean @default(false)
 everyDays Int @default(1) @map("every_days")
 nextPublishAt DateTime @map("next_publish_at")
 nextScanAt DateTime @default(now()) @map("next_scan_at")
 remaining Int @default(0)
 lastScanAt DateTime? @map("last_scan_at")
 lastError String? @map("last_error")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([tenantId,accountId,folderId])
 @@index([enabled,nextScanAt])
 @@map("publication_folders")
}
model PreparedPublication {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 userId String @db.Uuid @map("user_id")
 accountId String? @db.Uuid @map("account_id")
 fileId String? @map("file_id")
 ruleId String? @db.Uuid @map("rule_id")
 name String
 type String
 caption String @default("")
 model String?
 status String @default("QUEUED")
 postId String? @map("post_id")
 channelIds String[] @db.Uuid @map("channel_ids")
 result Json @default("{}")
 error String?
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([tenantId,accountId,fileId])
 @@unique([tenantId,fileId])
 @@index([status,updatedAt])
 @@map("prepared_publications")
}

model MailAccount {
 tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
 items MailItem[]
 campaigns MailCampaign[]
 @@unique([tenantId,id])
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 email String
 name String
 configEncrypted String @map("config_encrypted")
 active Boolean @default(true)
 lastSyncAt DateTime? @map("last_sync_at")
 lastError String? @map("last_error")
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([tenantId,email])
 @@map("mail_accounts")
}
model MailItem {
 account MailAccount @relation(fields:[tenantId,accountId],references:[tenantId,id],onDelete:Cascade)
 messageId String? @map("message_id")
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 accountId String @db.Uuid @map("account_id")
 externalId String @map("external_id")
 fromAddress String @map("from_address")
 toAddress String @map("to_address")
 subject String
 text String
 html String
 receivedAt DateTime @map("received_at")
 @@unique([tenantId,accountId,externalId])
 @@index([tenantId,receivedAt])
 @@map("mail_items")
}
model MailTemplate {
 tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 name String
 subject String
 html String
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([tenantId])
 @@map("mail_templates")
}
model MailCampaign {
 account MailAccount @relation(fields:[tenantId,accountId],references:[tenantId,id],onDelete:Cascade)
 deliveries MailDelivery[]
 kind String @default("MARKETING")
 inReplyTo String? @map("in_reply_to")
 @@unique([tenantId,id])
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 accountId String @db.Uuid @map("account_id")
 userId String @db.Uuid @map("user_id")
 name String
 subject String
 html String
 status String @default("DRAFT")
 scheduledAt DateTime? @map("scheduled_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([tenantId,status])
 @@map("mail_campaigns")
}
model MailDelivery {
 campaign MailCampaign @relation(fields:[tenantId,campaignId],references:[tenantId,id],onDelete:Cascade)
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 campaignId String @db.Uuid @map("campaign_id")
 email String
 name String
 status String @default("QUEUED")
 error String?
 providerId String? @map("provider_id")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([campaignId,email])
 @@index([status,updatedAt])
 @@map("mail_deliveries")
}
model InternalWorkflow {
 tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade)
 runs WorkflowRun[]
 @@unique([tenantId,id])
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid @map("tenant_id")
 userId String @db.Uuid @map("user_id")
 name String
 enabled Boolean @default(false)
 trigger String @default("SCHEDULE")
 timezone String @default("America/Sao_Paulo")
 nextRunAt DateTime @map("next_run_at")
