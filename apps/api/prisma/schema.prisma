  domainId       String?
  status         DeployStatus  @default(QUEUED)
  cfDeploymentId String?
  cfDeploymentUrl String?
  contentHash    String?
  errorMessage   String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  domain         SiteDomain?  @relation(fields: [domainId], references: [id])

  @@index([siteId])
  @@index([contentHash])
}

model SiteDocument {
  id        String   @id @default(cuid())
  siteId    String   @unique @db.Uuid
  document  Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions  SiteVersion[]

  @@index([siteId])
}

model SiteVersion {
  id             String   @id @default(cuid())
  siteDocumentId String
  version        Int
  document       Json
  createdBy      String
  createdAt      DateTime @default(now())

  siteDocument   SiteDocument @relation(fields: [siteDocumentId], references: [id], onDelete: Cascade)

  @@index([siteDocumentId])
  @@unique([siteDocumentId, version])
}

/// HUB de Sites: registra pedido, preview, aprovação, versão, histórico e auditoria.
/// Não renderiza HTML do site, não hospeda página e não substitui o repositório do site.
model SiteHubRequest {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  siteId       String?         @map("site_id") @db.Uuid
  slug         String
  name         String
  kind         String          @default("STATIC")
  status       SiteHubStatus   @default(DRAFT)
  brief        Json            @default("{}")
  repository   String?
  targetDomain String?         @map("target_domain")
  previewUrl   String?         @map("preview_url")
  previewSha   String?         @map("preview_sha")
  createdBy    String          @map("created_by") @db.Uuid
  decidedBy    String?         @map("decided_by") @db.Uuid
  decisionNote String?         @map("decision_note")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions     SiteHubVersion[]
  events       SiteHubEvent[]
  approvals    SiteHubApproval[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("site_hub_requests")
}

model SiteHubVersion {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  version     Int
  commitSha   String?  @map("commit_sha")
  previewUrl  String?  @map("preview_url")
  notes       String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  request     SiteHubRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, version])
  @@map("site_hub_versions")
}

model SiteHubApproval {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  decision    String
  note        String?
  decidedBy   String   @map("decided_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  request     SiteHubRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("site_hub_approvals")
}

model SiteHubEvent {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  action      String
  details     Json     @default("{}")
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  request     SiteHubRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([tenantId, createdAt])
  @@map("site_hub_events")
}

/// Decisões tomadas na Véxora sobre submissões do Directus: auditoria, dono da
/// decisão e idempotência. O status acompanha a chamada externa sem afirmar envio.
model SiteHubSubmissionDecision {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  submissionKey String   @map("submission_key")
  directusId    String?  @map("directus_id")
  decision      String
  reason        String?
  actorId       String   @map("actor_id") @db.Uuid
  status        String   @default("PROCESSING")
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, submissionKey])
  @@index([tenantId, createdAt])
  @@map("site_hub_submission_decisions")
}

enum SiteHubStatus {
  DRAFT
  PREVIEW_READY
  APPROVED
  REJECTED
  PUBLISH_REQUESTED
  PUBLISHED
  FAILED
}

/// Intake estruturado de briefing criativo. Registra insumos aprovados, sem
/// gerar, aprovar, publicar ou entregar peça alguma.
model CreativeBrief {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  title          String
  objective      String
  channelFormat  String              @map("channel_format")
  identity       String
  approvedSource String              @map("approved_source")
  deadline       DateTime            @db.Date
  approver       String
  destination    String
  status         String              @default("RECEIVED")
  createdBy      String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events         CreativeBriefEvent[]

  @@index([tenantId, createdAt])
  @@map("creative_briefs")
}

model CreativeBriefEvent {
  id        String       @id @default(uuid()) @db.Uuid
  briefId   String       @map("brief_id") @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  action    String
  details   Json         @default("{}")
  actorId   String?      @map("actor_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  brief     CreativeBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, createdAt])
  @@index([tenantId, createdAt])
  @@map("creative_brief_events")
}
