# Modelo apenas. Nenhum valor real deve entrar no repositório.

# --- Uso local: pnpm run dev ---------------------------------------------
DATABASE_URL=postgresql://payload_local:troque-esta-senha-local@127.0.0.1:5432/vexora_payload
PAYLOAD_SECRET=troque-por-uma-chave-longa-aleatoria-local
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# --- Uso no Dokploy: preencher no cofre do serviço Compose ----------------
# O Compose monta DATABASE_URL a partir destas variáveis. Preencha no cofre,
# nunca no repositório e nunca no chat.
POSTGRES_USER=payload_local
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=vexora_payload
PAYLOAD_PORT=3000

# PAYLOAD_URL, PAYLOAD_TOKEN e PAYLOAD_TENANT_ID pertencem aos consumidores
# (API da Véxora e Worker do formulário). Ficam no cofre desses serviços,
# não nesta aplicação.
