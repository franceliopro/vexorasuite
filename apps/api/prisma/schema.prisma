generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  status      String       @default("ACTIVE")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  contacts    Contact[]
  conversations Conversation[]
  messages    Message[]
  channelConnections ChannelConnection[]
  auditLogs   AuditLog[]
  tags        Tag[]

  @@map("tenants")
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  passwordHash    String            @map("password_hash")
  name            String
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  memberships     Membership[]
  auditLogs       AuditLog[]
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@map("users")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid @map("tenant_id")
  userId    String         @db.Uuid @map("user_id")
  role      MembershipRole @default(AGENT)
  createdAt DateTime       @default(now()) @map("created_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Contact {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid @map("tenant_id")
  name         String
  phone        String?
  email        String?
  source       String?
  externalId   String?        @map("external_id")
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, externalId])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("contacts")
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid @map("tenant_id")
  contactId   String             @db.Uuid @map("contact_id")
  channelConnectionId String?    @db.Uuid @map("channel_connection_id")
  assigneeId  String?            @db.Uuid @map("assignee_id")
  channel     String             @default("WHATSAPP")
  status      ConversationStatus @default(OPEN)
  subject     String?
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  assignee    User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    Message[]
  tags        ConversationTag[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, contactId])
  @@index([tenantId, channelConnectionId, status])
  @@map("conversations")
}

model ChannelConnection {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  provider    String   @default("WAHA")
  name        String
  sessionName String   @unique @map("session_name")
  status      String   @default("CONNECTING")
  lastError   String?  @map("last_error")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId, status])
  @@map("channel_connections")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid @map("tenant_id")
  conversationId    String           @db.Uuid @map("conversation_id")
  providerMessageId String?          @map("provider_message_id")
  direction         MessageDirection
  status            MessageStatus    @default(RECEIVED)
  content           String           @default("")
  contentType       String           @default("text") @map("content_type")
  senderName        String?           @map("sender_name")
  metadata          Json              @default("{}")
  occurredAt        DateTime          @default(now()) @map("occurred_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, conversationId, occurredAt])
  @@map("messages")
}

model Tag {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid @map("tenant_id")
  name      String
  color     String             @default("#7467e8")
  createdAt DateTime           @default(now()) @map("created_at")
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
  @@map("tags")
}

model ConversationTag {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid @map("conversation_id")
  tagId          String       @db.Uuid @map("tag_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([tagId])
  @@map("conversation_tags")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid @map("tenant_id")
  userId     String?  @db.Uuid @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}
