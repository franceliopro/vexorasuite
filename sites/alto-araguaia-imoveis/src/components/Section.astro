---
interface Props {
  id?: string;
  tone?: "plain" | "soft" | "yellow" | "navy";
  eyebrow?: string;
  title?: string;
  description?: string;
  narrow?: boolean;
}

const {
  id,
  tone = "plain",
  eyebrow,
  title,
  description,
  narrow = false,
} = Astro.props;
---

<section
  class:list={["section", `tone-${tone}`, { narrow }]}
  id={id}
>
  <div class="container">
    {(eyebrow || title || description) && (
      <div class="section-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {title && <h2>{title}</h2>}
        {description && <p>{description}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
