# Padrão seguro: sem PROVISIONER_MODE=real, nada é criado.
PORT=3001
PROVISIONER_MODE=simulation

# Habilitação explícita da camada real (somente depois dos contratos validados).
# PROVISIONER_MODE=real
# PROVISIONER_ALLOW_REAL_APPLY=1

# Estado persistido do provisionador (separado dos bancos dos clientes).
PROVISIONER_STATE_FILE=/var/lib/provisioner/state.json

# Pastas e Traefik.
PROVISIONER_SITES_ROOT=/sites
PROVISIONER_TRAEFIK_CONFIG_DIR=/etc/traefik/dynamic
PROVISIONER_TRAEFIK_NETWORK=estudio-de-sites
PROVISIONER_TLS_RESOLVER=letsencrypt
PROVISIONER_SITE_CONTAINER_TEMPLATE={slug}
PROVISIONER_SITE_PORT=80

# Imagens PHP fixadas por tag. Nunca use latest.
# Todas as 17 versões (5.2 a 8.6) estão habilitadas no contrato.
PROVISIONER_PHP_IMAGE_TEMPLATE=registry.internal/estudio/php:{version}-fpm
# Sobrescritas opcionais, se alguma versão exigir imagem diferente:
# PROVISIONER_PHP_IMAGES={"5.6":"registry.internal/estudio/php-legacy:5.6-fpm"}

# Adaptadores HTTP. Os segredos são caminhos de arquivos montados, não valores.
# PROVISIONER_DB_ADMIN_URL=http://admin-internal:8080
# PROVISIONER_DB_ADMIN_SECRET_FILE=/run/secrets/vx_db_admin_token
# PROVISIONER_FILEBROWSER_URL=http://filebrowser:8080
# PROVISIONER_FILEBROWSER_SECRET_FILE=/run/secrets/vx_filebrowser_token

# Webhook assinado da Véxora (escopo e rotação a definir).
# PROVISIONER_WEBHOOK_SECRET_FILE=/run/secrets/vx_webhook_secret
PROVISIONER_WEBHOOK_TOLERANCE_SECONDS=300

# Health-check real no domínio final.
PROVISIONER_HEALTH_TIMEOUT_MS=5000
PROVISIONER_HEALTH_RETRIES=1
